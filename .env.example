# =============================================================================
# Ultron — example configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and edit only what your machine needs:
#
#   cp .env.example .env
#
# The defaults below are the shipped, tested local-only profile. BACKEND=local
# needs no API key and no internet: llama.cpp serves the brain on this machine,
# faster-whisper transcribes on the CPU, and Piper speaks locally.
#
# Never commit .env — it is gitignored. Only this example file is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Core backend
# -----------------------------------------------------------------------------
# local  = 100% on-device (llama-server + faster-whisper + Piper). No key needed.
# gemini = original cloud stack, kept as a rollback path.
BACKEND=local

# llama-server (local brain). The manager health-checks this URL before each
# brain-backed command and spawns the binary below when nothing is listening.
LLAMA_BASE_URL=http://127.0.0.1:9931/v1
# Adjust these two absolute paths to wherever your binaries/models live.
LLAMA_SERVER_BIN=~/Downloads/LLAMA/llama-b12001-bin-ubuntu-cuda-13.4-x64/llama-b12001/llama-server
LLAMA_MODEL_PATH=~/Downloads/LFM3-1.7B-Q6_K.gguf
LLAMA_TIMEOUT_SEC=60
# Auto-start wait and log path (health check -> spawn -> wait -> stop on exit).
LLAMA_START_TIMEOUT_SEC=90
LLAMA_LOG_PATH=logs/llama-server.log

# Assistant identity (shown in the Dashboard header and chat replies).
ASSISTANT_NAME=Ultron

# -----------------------------------------------------------------------------
# Ears — speech to text (faster-whisper, CPU int8)
# -----------------------------------------------------------------------------
WHISPER_MODEL=small.en
# Downloads live here. If small.en's model.bin is missing, load_config falls
# back to base.en automatically so listening never stops.
WHISPER_MODEL_DIR=models/faster-whisper-small.en
# Natural lexical prompt that primes proper nouns without the old comma echo.
WHISPER_INITIAL_PROMPT=Ultron, Hey Ultron. Commands: open, close, switch, search on YouTube, Google, GitHub, Firefox, Brave, VS Code, F1, scroll down, new tab, close tab, type.
# Optional extra hotwords for all transcription. Blank by default: on unclear
# audio a long list leaks into the transcript.
WHISPER_HOTWORDS=
# Short hotwords used ONLY by hands-free `listen` and `wake-train`.
WHISPER_WAKE_HOTWORDS=Ultron, Firefox, GitHub, Brave, Downloads
# Add open app names and up to 8 visible button/tab labels to the hotwords.
WHISPER_DYNAMIC_HOTWORDS=true
# "Say it again" guard: reject when ANY ONE signal is bad (plus text rules).
WHISPER_MIN_AVG_LOGPROB=-0.90
WHISPER_MAX_NO_SPEECH_PROB=0.45
WHISPER_MAX_COMPRESSION_RATIO=2.4

# -----------------------------------------------------------------------------
# Microphone capture (PipeWire / pw-record)
# -----------------------------------------------------------------------------
# auto  = listen until you stop talking (default)
# fixed = record exactly VOICE_FIXED_SECONDS
VOICE_MODE=auto
# How long to wait for speech to start before reporting "I didn't hear anything".
VOICE_START_TIMEOUT_S=10
# Silence ceiling. 2.6 s keeps natural pauses between sentences inside one
# paragraph from cutting you off; the 1.8 s early check still ends short
# commands quickly, and Silero VAD ends a steady fan at 1.2 s.
VOICE_SILENCE_MS=2600
# One-shot /voice capture has no continuation decision: 850 ms after speech.
VOICE_RECORD_SILENCE_MS=850
# Hard cap. 60 s allows a long spoken paragraph.
VOICE_MAX_SECONDS=60.0
VOICE_FIXED_SECONDS=5
# Source volume enforced by the dynamic AGC guard (0.05 - 0.60). Kept at the
# measured-safe 0.21 so browser WebRTC gain cannot clip the input to a square wave.
MIC_SOURCE_VOLUME=0.21
# Optional specific PipeWire source (for example the RNNoise "Noise Canceling
# source"). Blank = system default.
MIC_SOURCE_NAME=
# The first N ms of every new pw-record stream is ignored (it opens with a pop);
# warm-up continues until the level is calm, capped by the max.
RECORDER_WARMUP_MS=300
RECORDER_WARMUP_MAX_MS=1500
# A sound must be this many dB above the running noise floor to count as speech.
VOICE_MIN_SNR_DB=10
# Optional cleanup before Whisper. 0 = off (the Nov 1 A/B showed no gain).
VOICE_DENOISE_STRENGTH=0
VOICE_HIGHPASS_HZ=100
# 1 saves workspace/voice_debug/attempt_*.wav + .json (newest 10 kept).
VOICE_DEBUG=false

# -----------------------------------------------------------------------------
# Wake word and hands-free listening
# -----------------------------------------------------------------------------
WAKE_WORD=ultron
# Extra spellings Whisper may hear, comma separated. Blank = built-in list.
WAKE_ALIASES=
# Learned aliases written by `main.py wake-train`.
WAKE_ALIASES_FILE=workspace/wake_aliases.json
# Accept the next sentence without the wake word after "Ultron" alone or a reply.
LISTEN_FOLLOWUP_S=8.0
# Early endpoint check for short self-contained commands.
LISTEN_EARLY_CHECK_MS=1800
# Ignore mic audio for this long after Piper stops (never record our own voice).
LISTEN_AFTER_SPEECH_MS=300
# 1 = log only the first word of speech that had no wake word (tuning). 0 = silent.
LISTEN_LOG_IGNORED=0
# 1 = show what Whisper heard and the wake score ON SCREEN ONLY.
LISTEN_DEBUG=0

# -----------------------------------------------------------------------------
# Mouth — neural text to speech (Piper, offline)
# -----------------------------------------------------------------------------
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_DIR=models/piper
VOICE_VOLUME=1.0
# Maximum length of a spoken local reply (characters).
VOICE_REPLY_MAX_CHARS=160
# auto = fast action confirmations + LLM for open questions; fast = deterministic
# only; llm = always ask the model.
ULTRON_BRAIN_REPLIES=auto

# -----------------------------------------------------------------------------
# Eyes and hands — screen awareness and desktop control
# -----------------------------------------------------------------------------
# How often the background ScreenWatcher refreshes the @ref element snapshot.
SCREEN_WATCH_INTERVAL=1.2
# Search engine for web_search (google | duckduckgo | bing).
SEARCH_ENGINE=google
# How "open the first result" resolves (never uses Google's blank btnI=1).
FIRST_RESULT_METHOD=google

# -----------------------------------------------------------------------------
# Environment server and Glassy Dashboard V18
# -----------------------------------------------------------------------------
# Local port for the REST/SSE environment server and the Dashboard UI.
ULTRON_ENV_PORT=9932

# -----------------------------------------------------------------------------
# Optional cloud rollback (only used when BACKEND=gemini)
# -----------------------------------------------------------------------------
# Leave BLANK for the default local-only profile.
GEMINI_API_KEY=
GEMINI_PAID_TIER=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNER_MODEL=gemini-4-argon
COMPUTER_USE_MODEL=gemini-3.8-flash
USE_PLANNER_MODEL=false
GEMINI_VOICE_LIVE_MODEL=gemini-3.8-live
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Puck
GEMINI_THINKING_LEVEL=medium
DAILY_TOKEN_CAP=500000
# Local fallback voice personality for spd-say (male1/male2/male3, pitch/rate -100..100).
VOICE_FALLBACK_VOICE_TYPE=male1
VOICE_FALLBACK_PITCH=15
VOICE_FALLBACK_RATE=10
SAVE_SCREENSHOTS=false
