# Copy this file to .env and paste your free-tier Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PAID_TIER=false

# Model IDs (Read from .env; switchable live in the Ultron Dashboard)
GEMINI_MODEL=gemini-3.8-flash
COMPUTER_USE_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_PLANNER_MODEL=gemini-4-argon
USE_PLANNER_MODEL=false

# Voice Models (Cloud-processed; keeps GTX 1650 idle)
GEMINI_VOICE_LIVE_MODEL=gemini-3.8-live
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Puck
VOICE_VOLUME=1.0
# Maximum length of a spoken local reply (chars)
VOICE_REPLY_MAX_CHARS=160
# Local fallback voice personality for spd-say (male1/male2/male3, pitch/rate -100..100)
VOICE_FALLBACK_VOICE_TYPE=male1
VOICE_FALLBACK_PITCH=15
VOICE_FALLBACK_RATE=10

# Backend: local (llama.cpp LFM3, no internet, no key) or gemini (cloud rollback)
BACKEND=local
LLAMA_BASE_URL=http://127.0.0.1:9931/v1
# Absolute paths on this machine (adjust if the binaries move)
LLAMA_SERVER_BIN=~/Downloads/LLAMA/llama-b12001-bin-ubuntu-cuda-13.4-x64/llama-b12001/llama-server
LLAMA_MODEL_PATH=~/Downloads/LFM3-1.7B-Q6_K.gguf
LLAMA_TIMEOUT_SEC=60
WHISPER_MODEL=base.en
PIPER_VOICE=en_US-lessac-medium

# Default Thinking Level (low | medium | high)
GEMINI_THINKING_LEVEL=medium

# Safety & Quota Caps
DAILY_TOKEN_CAP=500000
SAVE_SCREENSHOTS=false
ASSISTANT_NAME=Ultron

# Phase 2: auto-start llama-server (health check, spawn, 90 s wait, stop on exit)
LLAMA_START_TIMEOUT_SEC=90
LLAMA_LOG_PATH=logs/llama-server.log
# Phase 3: local ears (model is downloaded once into the project, then loaded offline)
WHISPER_MODEL_DIR=models/faster-whisper-base.en
# Microphone capture: auto listens until you stop talking; fixed records a fixed window.
VOICE_MODE=auto
# How long to wait for speech to start before saying "I didn't hear anything".
VOICE_START_TIMEOUT_S=10
# Continuous silence after speech that ends the recording (2 s; pauses up to ~1.8 s are kept).
VOICE_SILENCE_MS=2000
VOICE_MAX_SECONDS=30
VOICE_FIXED_SECONDS=5
# 1 saves workspace/voice_debug/attempt_*.wav + .json for every attempt (newest 10 kept).
VOICE_DEBUG=false
# Optional: set the microphone source volume once at chat/voice-test start.
# A number from 0.05 to 0.6. Leave blank to leave the system mic volume untouched.
MIC_SOURCE_VOLUME=
# Optional: record from a specific PipeWire source (for example the RNNoise
# "Noise Canceling source"). Blank = default source. See docs/NOISE_PLAN.md.
MIC_SOURCE_NAME=
# The first N ms of every new pw-record stream is ignored (it opens with a loud pop).
# The warm-up then continues until the level is calm, but no longer than the max.
RECORDER_WARMUP_MS=300
RECORDER_WARMUP_MAX_MS=1500
# A sound must be this many dB above the running noise floor to count as speech,
# so steady noise (a fan) can never start or hold a recording.
VOICE_MIN_SNR_DB=10
# Optional clean-up before Whisper. OFF by default: the Nov 1 A/B on the real clips
# showed no gain and one clean clip got worse. 0.6 is the tested value when enabled
# (max 0.8); 0 = off.
VOICE_DENOISE_STRENGTH=0
VOICE_HIGHPASS_HZ=100
# Hands-free mode (main.py listen): the sentence must start with the wake word.
WAKE_WORD=ultron
# Optional extra spellings Whisper may hear, comma separated. Leave BLANK to use the
# built-in list (see docs/PROGRESS.md).
WAKE_ALIASES=
# After "Ultron" alone or after a reply, accept the next sentence without the wake word.
LISTEN_FOLLOWUP_S=6
# After this much silence, transcribe early and finish if the sentence is complete.
LISTEN_EARLY_CHECK_MS=800
# Ignore mic audio for this long after Piper stops (never record our own voice).
LISTEN_AFTER_SPEECH_MS=300
# 1 = log only the FIRST WORD of speech that had no wake word (tuning). 0 = silent.
LISTEN_LOG_IGNORED=0
# 1 = show what Whisper heard and the wake score ON SCREEN ONLY (never logged/saved).
LISTEN_DEBUG=0
# Search engine for web_search / open the first result (duckduckgo | google | bing).
SEARCH_ENGINE=duckduckgo

# Optional: extra hotwords for faster-whisper. Leave BLANK (off) by default.
# Hotwords bias the decoder but on unclear audio they leak into the transcript as
# comma-separated word lists, so only set this if you really need it.
WHISPER_HOTWORDS=
# "Say it again" guard: reject when ANY ONE signal is bad (plus text rules).
WHISPER_MIN_AVG_LOGPROB=-1.0
WHISPER_MAX_NO_SPEECH_PROB=0.60
WHISPER_MAX_COMPRESSION_RATIO=2.4
# Phase 4: local mouth (Piper voice downloaded once into the project, then loaded offline)
PIPER_VOICE_DIR=models/piper
