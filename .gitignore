# =============================================================================
# Ultron — things that must never be pushed
# =============================================================================

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Virtual environments
.venv/
venv/
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Local only: model weights, recordings, logs, scratch workspace
models/
logs/
workspace/
!workspace/.gitkeep
.backups/
*.log

# Model and archive binaries
*.gguf
*.onnx
*.bin
*.wav
*.mp4
*.tar.gz
*.zip

# Local databases (the planned SQLite memory engine)
*.sqlite
*.sqlite3
*.db

# Demo / scratch reference directories (workspace-<uuid>)
workspace-*/

# Tooling metadata
.commandcode/
